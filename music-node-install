#!/usr/bin/env bash

# run this under screen/tmux coz it takes forever
# safe to re-run; updates shit as necessary
# example usage
# screen pi-install
# ssh nes-pi
# curl myscript | bash

# TODO add a wrapper script that fires off updates / installs on a known list of pis, using the pattern found above
# will still have to manually check in on it tho

set -e

# 54000 = 15 hours
# enough to safely never loop overnight
pinkNoiseTargetLength=54000
pinkNoiseTempLength=60

optPinkNoiseOnBoot=0
optMqttMonitor=0

musicNodeRootGitUrl='https://github.com/buckmanc/pi-music-nodes'
uvInstallUrl='https://astral.sh/uv/install.sh'
raspotifyInstallUrl='https://raw.githubusercontent.com/dtcooper/raspotify/refs/heads/master/install.sh'
rpiMqttMonitorInstallUrl='https://raw.githubusercontent.com/hjelev/rpi-mqtt-monitor/master/remote_install.sh'

homeDir="$HOME"
scriptDir="$homeDir/.local/bin"
musicNodeTempPath="${TMPDIR:-/tmp}/pi-music-nodes"
uvPath="$homeDir/.local/bin/uv"
sendspinPath="$homeDir/.local/bin/sendspin"
sendspinConfig="$homeDir/.config/sendspin/settings-daemon.json"
repoSendspinConfig="$musicNodeTempPath/config/sendspin-settings-daemon.json"

# add mkdir -p behaviour to cp
mkcp() {
	src="$1"
	dest="$2"
	destExt="${dest##*.}"

	mkdir -p "$(dirname "$dest")" && cp "$src" "$dest"
	if [[ "$destExt" == "sh" ]]
	then
		chmod +x "$dest"
	fi
}

merge_json_configs() {
	local base_file="$1"
	local overlay_file="$2"
	local tmp_file="${base_file}.tmp"

	jq -s '.[0] as $base | .[1] as $override | $base + ($override | with_entries(select(.value != null)))' \
	 "$base_file" "$overlay_file" > "$tmp_file"

	if [[ ! -s "$tmp_file" ]]
	then
		echo 'error merging in sendsoin config!' >&2
		exit 1
	fi

	mv "$tmp_file" "$base_file"
}

getManufacturer() {

	modelNamePaths=('/proc/device-tree/model' '/sys/devices/virtual/dmi/id/product_name')
	for path in "${modelNamePaths[@]}"
	do
		if [[ -f "$path" ]]
		then
			devMan="$(cat "$path" | tr -d '\0')"
			break
		fi
	done

	echo "${devMan:-openvoid.org}"
}

if [[ "$EUID" -eq 0 ]]
then
	echo "heavens to betsy, don't run this script with sudo!"
	exit 1
fi

echo "let's riggidy roll"
if ! sudo -v
then
	echo "we need sudo to riggidy roll :("
	exit 1
fi

# this is gonna ask every time, that's pretty annoying
# but I guess it probably should. we won't be running this every day, after all
if ! systemctl --user is-active --quiet "mpc-pink-noise-on-boot"
then
	read -p "Would you like to enable pink noise on boot? (y/n) " -n 1 -r
	echo
	if [[ "$REPLY" =~ ^[Yy]$ ]]
	then
		optPinkNoiseOnBoot=1
	fi
fi

if (! type rpi-mqtt-monitor > /dev/null 2>&1)
then
	read -p "Would you like to enable rpi-mqtt-monitor? You'll need your mqtt credentials. (y/n) " -n 1 -r
	echo
	if [[ "$REPLY" =~ ^[Yy]$ ]]
	then
		optMqttMonitor=1
	fi
fi

# update and install dependencies
echo
echo 'Updating...'
sudo apt-get update -qq && sudo apt-get upgrade -yq
sudo apt-get install -y vim curl libffi-dev python3-dev libjpeg-dev zlib1g-dev libportaudio2 libopenblas0 mpd sox mpc alsa-utils jq pipewire pipewire-pulse pipewire-alsa wireplumber git python3-pip python3-wheel python3-packaging smartmontools pulseaudio-utils

echo "cloning to temp dir..."
rm -rf "$musicNodeTempPath"
git clone "$musicNodeRootGitUrl" "$musicNodeTempPath"

# swap in local vars
deviceManufacturer="$(getManufacturer)"
sed -i 's/${NODE_NAME}/'"$(hostname)"'/g' "$musicNodeTempPath/config/mpd.conf"
jq --arg devMan "$deviceManufacturer" '.manufacturer = $devMan' "$repoSendspinConfig" \
	> "$repoSendspinConfig.tmp" && mv "$repoSendspinConfig.tmp" "$repoSendspinConfig"

# install configs
mkcp "$musicNodeTempPath/config/mpd.conf" "$homeDir/.config/mpd/mpd.conf"
mkdir -p "$homeDir/mpd"
mkcp "$musicNodeTempPath/config/wireplumber.conf" "$homeDir/.config/wireplumber/wireplumber.conf.d/music_node_defaults.conf"

# if the sendspin config already exists, merge our files only overwriting nulls
if [[ -s "$sendspinConfig" ]]
then
	merge_json_configs "$sendspinConfig" "$repoSendspinConfig"
else
	mkcp "$repoSendspinConfig" "$sendspinConfig"
fi

# install scripts
mkcp "$musicNodeTempPath/scripts/generate-pink-noise.sh" "$scriptDir/generate-pink-noise.sh"
mkcp "$musicNodeTempPath/scripts/mpc-pink-noise-init.sh" "$scriptDir/mpc-pink-noise-init.sh"

# install services
mkdir -p "$homeDir/.config/systemd/user"
cp "$musicNodeTempPath/systemd/"*.service "$homeDir/.config/systemd/user/"
cp "$musicNodeTempPath/systemd/"*.timer "$homeDir/.config/systemd/user/"

# all services are enabled and started at the end
# so there's no need to do so mid stream unless we need config files written or reloaded

# wipe the static motd if it's still the default
if grep -Piq '^The programs included with the Debian GNU/Linux system are free software' /etc/motd
then
	sudo truncate -s 0 /etc/motd
fi

# start a dummy session for mpd user on boot
# required for headless audio under pipewire
loginctl enable-linger "$USER"

if ! id -nG "$USER" | grep -qw audio; then
	sudo usermod -aG audio "$USER"
	echo "Added $USER to the audio group — this needs a fresh login to take effect."
	echo "Log out, log back in, and re-run this script to finish setup."
	exit 0
fi

# switch the mpd service from system to user
# the package comes with a user service file, so no shuffling there
# gotta spin this up early so we can set defaults
# it also triggers pipewire to spin up
sudo systemctl disable --now mpd
systemctl --user daemon-reload
systemctl --user enable --now mpd

# -------- remote monitoring for home assistant --------
# this goes near the top coz it's a lot of manual questions
if (type rpi-mqtt-monitor 2>/dev/null)
then
	rpi-mqtt-monitor --update
else
	if [[ "$optMqttMonitor" == 1 ]]
	then
		# smartmontools enables itself by default, but the rpi-mqtt-monitor installer may still warn about it
		# on pis it tends to fail due to "no devices to monitor"
		bash <(curl -s "$rpiMqttMonitorInstallUrl")
	fi
fi

# -------- sendspin daemon --------

# install / update uv
if test -x "$uvPath"
then
	"$uvPath" self update
else
	curl -LsSf "$uvInstallUrl" | sh
fi

# install / update sendspin
if test -x "$sendspinPath"
then
	"$uvPath" tool upgrade sendspin
	systemctl --user restart sendspin
else
	# install sendspin
	"$uvPath" tool install sendspin
fi

# -------- raspotify daemon --------
curl -sL "$raspotifyInstallUrl"  | sh

# disable the system-level service in favor of our user-level service
sudo systemctl disable --now raspotify

# -------- pink noise via mpd/mpc --------
ambianceDir="$homeDir/mpd/music/ambient"
pinkNoisePath="$ambianceDir/pink_noise.flac"

mkdir -p "$ambianceDir"

if [[ ! -f "$pinkNoisePath" ]]
then
	# generate a placeholder pink noise file, full one comes later
	"$scriptDir/generate-pink-noise.sh" "$pinkNoisePath" "$pinkNoiseTempLength"
fi

# -------- enable services --------

services=(pipewire pipewire-pulse wireplumber sendspin raspotify mpd mpc-pink-noise-init mpc-pink-noise-init.timer)

if systemctl --user is-active --quiet "mpc-pink-noise-on-boot" || [[ "$optPinkNoiseOnBoot" == 1 ]]
then
	services+=(mpc-pink-noise-on-boot)
fi

# pick up all service file changes
systemctl --user daemon-reload

echo "activating services..."

for svc in "${services[@]}"
do
	systemctl --user enable --now "$svc" --quiet || true
done

# report status to the user
"$musicNodeTempPath/scripts/status.sh"

if [[ -s "$pinkNoisePath" ]]
then
	pinkNoiseCurrentLength="$(soxi -D "$pinkNoisePath")"
	pinkNoiseCurrentLength="${pinkNoiseCurrentLength%%.*}"
else
	pinkNoiseCurrentLength=0
fi

echo
echo 'your pi music node is now set up and ready to use'

# -------- big pink noise generation --------

# check if remaining drive space is too small for pink noise and ask if the user wants to generate the full file
if [[ "$pinkNoiseCurrentLength" -lt "$pinkNoiseTargetLength" ]]
then
	# Check available disk space (in KB)
	available_kb=$(df "$ambianceDir" --output=avail -k | tail -n1)
	# Estimate needed space: ~13GB for 15 hours of pink noise FLAC
	needed_kb=$((13 * 1024 * 1024))  # 13GB in KB

	if [[ $available_kb -lt $needed_kb ]]
	then
		echo
		echo "WARNING: Low disk space detected!"
		echo "Available: $(($available_kb / 1024 / 1024)) GB"
		echo "Estimated needed for full pink noise: ~13 GB"
		echo
		read -p "Generate full pink noise file anyway? (y/n) " -n 1 -r
		echo
		if [[ ! "$REPLY" =~ ^[Yy]$ ]]
		then
			exit 0
		fi
	fi

	echo
	echo 'next comes pink noise generation, which will take roughly another hour (on a Pi 3 at least)'
	echo -n 'should be done about ' && date '+%F %R' --date '1 hour'

	time "$scriptDir/generate-pink-noise.sh" "$pinkNoisePath" "$pinkNoiseTargetLength"
fi
