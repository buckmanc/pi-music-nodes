#!/usr/bin/env bash

# run this under screen/tmux coz it takes forever
# safe to re-run; updates shit as necessary
# example usage
# screen pi-install
# ssh nes-pi
# curl myscript | bash

# TODO add a wrapper script that fires off updates / installs on a known list of pis
# will still have to manually check in on it tho

set -e

# 54000 = 15 hours
# enough to safely never loop overnight
pinkNoiseTargetLength=54000
pinkNoiseTempLength=60

musicNodeRootGitUrl='https://github.com/buckmanc/pi-music-nodes'
uvInstallUrl='https://astral.sh/uv/install.sh'
raspotifyInstallUrl='https://raw.githubusercontent.com/dtcooper/raspotify/refs/heads/master/install.sh'
rpiMqttMonitorInstallUrl='https://raw.githubusercontent.com/hjelev/rpi-mqtt-monitor/master/remote_install.sh'

homeDir="/var/lib/mpd"
musicNodeTempPath="${TMPDIR:-/tmp}/pi-music-nodes"
uvPath="$homeDir/.local/bin/uv"
sendspinPath="$homeDir/.local/bin/sendspin"
raspotifyConfig="/etc/raspotify/conf"
sendspinConfig="$homeDir/.config/sendspin/settings-daemon.json"
repoSendspinConfig="$musicNodeTempPath/config/sendspin-settings-daemon.json"

# add mkdir -p behaviour to cp
mkcp() {
	src="$1"
	dest="$2"
	destExt="${dest##*.}"

	sudo mkdir -p "$(dirname "$dest")" && sudo cp "$src" "$dest"
	if [[ "$destExt" == "sh" ]]
	then
		sudo chmod +x "$dest"
	fi
}

# merge JSON configs: only overwrite null values in base with values from overlay
# preserves existing non-null values, adds new keys, recurses into objects
merge_json_configs() {
	local base_file="$1"
	local overlay_file="$2"
	local tmp_file="${base_file}.tmp"

	jq -s '
		def deep_merge($new):
			reduce ($new | keys_unsorted[]) as $k (
				.;
				if .[$k] == null then
					.[$k] = $new[$k]
				elif (.[$k] | type) == "object" and ($new[$k] | type) == "object" then
					.[$k] = (.[$k] | deep_merge($new[$k]))
				else
					.
				end
			);
		.[0] | deep_merge(.[1])
	' "$base_file" "$overlay_file" > "$tmp_file" && mv "$tmp_file" "$base_file"
}

getManufacturer() {

	modelNamePaths=('/proc/device-tree/model' '/sys/devices/virtual/dmi/id/product_name')
	for path in "${modelNamePaths[@]}"
	do
		if [[ -f "$path" ]]
		then
			devMan="$(cat "$path" | tr -d '\0')"
			break
		fi
	done

	echo "${devMan:-openvoid.org}"
}

if [[ "$EUID" -eq 0 ]]
then
	echo "heavens to betsy, don't run this script with sudo!"
	exit 1
fi

echo "let's riggidy roll"
if ! sudo -v
then
	echo "we need sudo to riggidy roll :("
	exit 1
fi

read -p "Would you like to enable pink noise on boot? (y/n) " -n 1 -r
echo
if [[ "$REPLY" =~ ^[Yy]$ ]]
then
	optPinkNoiseOnBoot=1
else
	optPinkNoiseOnBoot=0
fi

read -p "Would you like to enable rpi-mqtt-monitor? You'll need your mqtt credentials. (y/n) " -n 1 -r
echo
if [[ "$REPLY" =~ ^[Yy]$ ]]
then
	optMqttMonitor=1
else
	optMqttMonitor=0
fi

# update and install dependencies
sudo apt update && sudo apt upgrade -y
sudo apt install -y vim curl libffi-dev python3-dev libjpeg-dev zlib1g-dev libportaudio2 libopenblas0 mpd sox mpc alsa-utils jq pipewire pipewire-pulse pipewire-alsa wireplumber git python3-pip python3-wheel python3-packaging smartmontools

echo "cloning to temp dir..."
rm -rf "$musicNodeTempPath"
git clone "$musicNodeRootGitUrl" "$musicNodeTempPath"

# swap in local vars
deviceManufacturer="$(getManufacturer)"
mpdUid="$(id --user mpd)"
sed -i 's/${NODE_NAME}/'"$(hostname)"'/g' "$musicNodeTempPath/config/mpd.conf"
sed -i 's/${MPD_UID}/'"$mpdUid"'/g' "$musicNodeTempPath/systemd/"*
sed -i 's|\${SENDSPIN_PATH}|'"$sendspinPath"'|g' "$musicNodeTempPath/systemd/"*
jq --arg devMan "$deviceManufacturer" '.manufacturer = $devMan' "$repoSendspinConfig" \
	> "$repoSendspinConfig.tmp" && mv "$repoSendspinConfig.tmp" "$repoSendspinConfig"

# if the sendspin config already exists, merge our files only overwriting nulls
if [[ -f "$sendspinConfig" ]]
then
	merge_json_configs "$sendspinConfig" "$repoSendspinConfig"
else
	mkcp "$repoSendspinConfig" "$sendspinConfig"
fi

# install scripts
mkcp "$musicNodeTempPath/scripts/generate-pink-noise.sh" /usr/local/bin/generate-pink-noise.sh
mkcp "$musicNodeTempPath/scripts/mpc-pink-noise-init.sh" /usr/local/bin/mpc-pink-noise-init.sh

# install configs
mkcp "$musicNodeTempPath/config/mpd.conf" /etc/mpd.conf

# install services
sudo cp "$musicNodeTempPath/systemd/"*.service "/etc/systemd/system/"
sudo cp "$musicNodeTempPath/systemd/"*.timer "/etc/systemd/system/"

# install service overrides
mkcp "$musicNodeTempPath/systemd/override.conf" /etc/systemd/system/sendspin.service.d/override.conf
mkcp "$musicNodeTempPath/systemd/override.conf" /etc/systemd/system/raspotify.service.d/override.conf
mkcp "$musicNodeTempPath/systemd/override.conf" /etc/systemd/system/mpd.service.d/override.conf
mkcp "$musicNodeTempPath/systemd/override.conf" /etc/systemd/system/mpc-pink-noise-init.service.d/override.conf
mkcp "$musicNodeTempPath/systemd/override.conf" /etc/systemd/system/mpc-pink-noise-on-boot.service.d/override.conf

# all services are enabled and started at the end
# so there's no need to do so mid stream unless we need config files written or reloaded

# start a dummy session for mpd user on boot
# required for headless audio under pipewire
sudo loginctl enable-linger mpd

runtimeDir="/run/user/$mpdUid"
dbusAddress="unix:path=${runtimeDir}/bus"

# give pipewire a sec to spin up
# mpd service should be running now due to apt install mpd
for attempt in $(seq 1 60)
do
	# silence shellcheck warning
	echo "$attempt" > /dev/null
	# hardware volume
	# setting the default high so the software volumes can be set lower and still have headroom
	# wpctl set-volume @DEFAULT_AUDIO_SINK@ 90% && break
	if sudo -u mpd XDG_RUNTIME_DIR="$runtimeDir" DBUS_SESSION_BUS_ADDRESS="$dbusAddress" wpctl set-volume @DEFAULT_AUDIO_SINK@ 90% 2>/dev/null; then
		break
	fi
	
	sleep 1
done

# -------- remote monitoring for home assistant --------
# this goes near the top coz it's a lot of manual questions
if (type rpi-mqtt-monitor 2>/dev/null)
then
	rpi-mqtt-monitor --update
else
	if [[ "$optMqttMonitor" == 1 ]]
	then
		bash <(curl -s "$rpiMqttMonitorInstallUrl")
	fi
fi

# -------- sendspin daemon --------

# install / update uv
if sudo -u mpd test -x "$uvPath"
then
	sudo -u mpd "$uvPath" self update
else
	sudo -u mpd bash -c "curl -LsSf '$uvInstallUrl' | sh"
fi

# install / update sendspin
if sudo -u mpd test -x "$sendspinPath"
then
	sudo -u mpd bash -c "$uvPath tool upgrade sendspin"
	sudo systemctl restart sendspin
else
	# install sendspin as the mpd user
	sudo -u mpd bash -c "$uvPath tool install sendspin"
fi

# -------- raspotify daemon --------
raspotifyFreshInstall=0

if ! sudo test -f "$raspotifyConfig"
then
	raspotifyFreshInstall=1
fi

curl -sL "$raspotifyInstallUrl"  | sh

if [[ "$raspotifyFreshInstall" == 1 ]]
then
	# TODO this may be necessary on updates
	# set default vol and backend to pulse
	sudo sed -i '/^LIBRESPOT_INITIAL_VOLUME=/d'	"$raspotifyConfig"
	sudo sed -i '/^LIBRESPOT_BACKEND=/d'		"$raspotifyConfig"
	echo 'LIBRESPOT_INITIAL_VOLUME="20"'	| sudo tee -a "$raspotifyConfig" > /dev/null
	echo 'LIBRESPOT_BACKEND="pulseaudio"'	| sudo tee -a "$raspotifyConfig" > /dev/null

	# reload with the new raspotify config
	sudo systemctl restart raspotify
fi

# -------- pink noise via mpd/mpc --------
ambianceDir='/var/lib/mpd/music/ambient'
pinkNoisePath="$ambianceDir/pink_noise.flac"
mpdFreshInstall=0

sudo mkdir -p "$ambianceDir"

if [[ ! -f "$pinkNoisePath" ]]
then
	mpdFreshInstall=1

	# generate a placeholder pink noise file, full one comes later
	sudo /usr/local/bin/generate-pink-noise.sh "$pinkNoisePath" "$pinkNoiseTempLength"
fi

if [[ "$mpdFreshInstall" == 1 ]]
then
	# set a default volume once
	# though this will be more decided by home assistant, generally speaking
	# safe to run now as apt install mpd starts the service already
	mpc volume 20
fi

# -------- status check --------

services=(sendspin raspotify mpd mpc-pink-noise-init mpc-pink-noise-init.timer)
if [[ "$optPinkNoiseOnBoot" == 1 ]]
then
	services+=(mpc-pink-noise-on-boot)
fi

if [[ "$optMqttMonitor" == 1 ]]
then
	services+=(rpi-mqtt-monitor)
fi

# pick up all service file changes
sudo systemctl daemon-reload

echo 'checking daemon statuses:'

for svc in "${services[@]}"; do
	# make sure everything is enabled too
	# ignore standard output but allow error messages
	sudo systemctl enable --now "$svc" > /dev/null
	printf "%-25s %s\n" "${svc}:" "$(systemctl is-active "$svc" || true)"
done

if [[ -s "$pinkNoisePath" ]]
then
	pinkNoiseCurrentLength="$(soxi -D "$pinkNoisePath")"
	pinkNoiseCurrentLength="${pinkNoiseCurrentLength%%.*}"
else
	pinkNoiseCurrentLength=0
fi

echo
echo 'your pi music node is now set up and ready to use'

# TODO check if remaining drive space is too small for pink noise

if [[ "$pinkNoiseCurrentLength" -lt "$pinkNoiseTargetLength" ]]
then
	echo
	echo 'next comes pink noise generation, which will take very roughly another hour'
	time sudo /usr/local/bin/generate-pink-noise.sh "$pinkNoisePath" "$pinkNoiseTargetLength"
fi
